<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Add Nearby Place</title>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<main class="mp-page">
  <div class="container py-5" style="max-width: 700px;">
    <div class="mp-form-card">
      <h2 class="mb-4">Add Nearby Place</h2>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form action="/nearby/add" method="POST">
        <div class="row">
          <div class="mb-3 col-md-7">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" required value="<%= values.name || '' %>">
          </div>
          <div class="mb-3 col-md-5">
            <label class="form-label">City</label>
            <input type="text" class="form-control" name="city" required value="<%= values.city || '' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Distance from Prayagraj <span class="text-muted">(optional, e.g. "~120 km")</span></label>
          <input type="text" class="form-control" name="distanceFromPrayagraj" value="<%= values.distanceFromPrayagraj || '' %>">
        </div>

        <div class="mb-3">
          <label class="form-label">Short Description <span class="text-muted">(shown on the homepage card)</span></label>
          <textarea class="form-control" name="shortDescription" rows="2" required><%= values.shortDescription || '' %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">History &amp; Significance <span class="text-muted">(shown on the full detail page)</span></label>
          <textarea class="form-control" name="history" rows="6" required><%= values.history || '' %></textarea>
        </div>

        <div class="row">
          <div class="mb-3 col-md-8">
            <label class="form-label">Image URL <span class="text-muted">(optional)</span></label>
            <input type="url" class="form-control" name="imageUrl" value="<%= values.imageUrl || '' %>" placeholder="https://...">
            <div class="form-text">Use a royalty-free image URL you have rights to use (e.g. your own photo, or a properly licensed source).</div>
          </div>
          <div class="mb-3 col-md-4">
            <label class="form-label">Display Order <span class="text-muted">(optional)</span></label>
            <input type="number" class="form-control" name="displayOrder" value="<%= values.displayOrder || '0' %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Google Maps Link <span class="text-muted">(optional)</span></label>
          <input type="url" class="form-control" name="mapsUrl" value="<%= values.mapsUrl || '' %>" placeholder="https://maps.google.com/...">
        </div>

        <button type="submit" class="btn mp-btn-primary mt-2">Add Place</button>
        <a href="/nearby" class="btn mp-btn-outline mt-2" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Cancel</a>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>

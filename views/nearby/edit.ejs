<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Edit Nearby Place</title>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<main class="mp-page">
  <div class="container py-5" style="max-width: 700px;">
    <div class="mp-form-card">
      <h2 class="mb-4">Edit Nearby Place</h2>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form action="/nearby/edit/<%= place._id %>" method="POST">
        <div class="row">
          <div class="mb-3 col-md-7">
            <label class="form-label">Name</label>
            <input type="text" class="form-control" name="name" required value="<%= place.name %>">
          </div>
          <div class="mb-3 col-md-5">
            <label class="form-label">City</label>
            <input type="text" class="form-control" name="city" required value="<%= place.city %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Distance from Prayagraj</label>
          <input type="text" class="form-control" name="distanceFromPrayagraj" value="<%= place.distanceFromPrayagraj || '' %>">
        </div>

        <div class="mb-3">
          <label class="form-label">Short Description</label>
          <textarea class="form-control" name="shortDescription" rows="2" required><%= place.shortDescription %></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label">History &amp; Significance</label>
          <textarea class="form-control" name="history" rows="6" required><%= place.history %></textarea>
        </div>

        <div class="row">
          <div class="mb-3 col-md-8">
            <label class="form-label">Image URL</label>
            <input type="url" class="form-control" name="imageUrl" value="<%= place.imageUrl || '' %>">
          </div>
          <div class="mb-3 col-md-4">
            <label class="form-label">Display Order</label>
            <input type="number" class="form-control" name="displayOrder" value="<%= place.displayOrder || 0 %>">
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Google Maps Link</label>
          <input type="url" class="form-control" name="mapsUrl" value="<%= place.mapsUrl || '' %>">
        </div>

        <button type="submit" class="btn mp-btn-primary mt-2">Update Place</button>
        <a href="/nearby" class="btn mp-btn-outline mt-2" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Cancel</a>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Nearby Places</title>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<main class="mp-page">
  <div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
      <h2 class="mp-section-title">🗺️ Nearby Places Worth Visiting</h2>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <a href="/nearby/add" class="btn mp-btn-primary btn-sm">+ Add Place</a>
      <% } %>
    </div>
    <p class="text-muted mb-4">Popular pilgrimage stops near Prayagraj, worth visiting before or after the Mahakumbh.</p>

    <% if (!places || places.length === 0) { %>
      <div class="mp-empty"><p class="fs-5">No nearby places listed yet.</p></div>
    <% } else { %>
      <div class="row g-4">
        <% places.forEach(p => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <a href="/nearby/<%= p._id %>" class="text-decoration-none">
              <div class="card mp-card">
                <div class="mp-place-image" style="<%= p.imageUrl ? `background-image:url('${p.imageUrl}');` : '' %>">
                  <% if (!p.imageUrl) { %><span>🛕</span><% } %>
                </div>
                <div class="card-body">
                  <span class="mp-badge mb-2 d-inline-block"><%= p.city %></span>
                  <h5 class="card-title"><%= p.name %></h5>
                  <p class="card-text small text-muted"><%= p.shortDescription %></p>
                  <% if (p.distanceFromPrayagraj) { %>
                    <p class="card-text small mb-0">📍 <%= p.distanceFromPrayagraj %> from Prayagraj</p>
                  <% } %>
                </div>
              </div>
            </a>
            <% if (currentUser && currentUser.role === 'admin') { %>
              <div class="mt-2">
                <a href="/nearby/edit/<%= p._id %>" class="btn btn-sm mp-btn-warning">Edit</a>
                <form action="/nearby/delete/<%= p._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this place?');">
                  <button type="submit" class="btn btn-sm mp-btn-danger">Delete</button>
                </form>
              </div>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Report Crowd Density</title>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<main class="mp-page">
  <div class="container py-5" style="max-width: 560px;">
    <div class="mp-form-card">
      <h2 class="mb-4">Report Crowd Density</h2>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <% if (!facilities || facilities.length === 0) { %>
        <p class="text-muted">No facilities exist yet — <a href="/facilities/add">add one first</a>.</p>
      <% } else { %>
        <form action="/crowd/add" method="POST">
          <div class="mb-3">
            <label class="form-label">Facility</label>
            <select class="form-select" name="facility" required>
              <option value="">Select Facility</option>
              <% facilities.forEach(f => { %>
                <option value="<%= f._id %>" <%= values.facility === f._id.toString() ? 'selected' : '' %>>
                  <%= f.name %> (<%= f.type %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Density Level</label>
            <select class="form-select" name="density" required>
              <option value="">Select Level</option>
              <% densityLevels.forEach(d => { %>
                <option value="<%= d %>" <%= values.density === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Note <span class="text-muted">(optional)</span></label>
            <textarea class="form-control" name="note" rows="2"><%= values.note || '' %></textarea>
          </div>

          <button type="submit" class="btn mp-btn-primary mt-2">Submit Report</button>
          <a href="/crowd" class="btn mp-btn-outline mt-2" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Cancel</a>
        </form>
      <% } %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Register</title>
  <%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

<main class="mp-auth-wrap">
  <div class="mp-form-card mp-auth-card">
    <h2 class="mb-4 text-center">Create an Account</h2>
    <p class="text-center text-muted small mb-3">Registers you as a visitor. Want to post events? Ask an admin to upgrade your account to organizer.</p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/register" method="POST">
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input type="text" class="form-control" name="username" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" class="form-control" name="password" required minlength="6">
      </div>
      <div class="mb-3">
        <label class="form-label">Confirm Password</label>
        <input type="password" class="form-control" name="confirmPassword" required minlength="6">
      </div>
      <button type="submit" class="btn mp-btn-primary w-100">Create Account</button>
    </form>

    <p class="text-center mt-3 mb-0 small">
      Already have an account? <a href="/login">Login</a>
    </p>
  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>

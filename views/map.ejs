<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Map</title>
  <%- include('partials/head') %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>
<body>

<%- include('partials/navbar') %>

<main class="mp-page">
  <div class="container mt-4 mb-5">
    <h2 class="mp-section-title mb-4">🗺️ Mahakumbh Map</h2>

    <form action="/map" method="GET" class="mp-filter-bar row g-3 mb-4">
      <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="All">All</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Location</label>
        <select name="location" class="form-select">
          <option value="All">All</option>
          <% locations.forEach(loc => { %>
            <option value="<%= loc %>" <%= query.location === loc ? 'selected' : '' %>><%= loc %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4 d-flex align-items-end gap-2">
        <button type="submit" class="btn mp-btn-primary">Apply</button>
        <a href="/map" class="btn mp-btn-outline" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Clear</a>
      </div>
    </form>

    <% if (skippedCount > 0) { %>
      <p class="text-muted small">
        ⚠️ <%= skippedCount %> event(s) aren't shown because their location isn't mapped to coordinates yet.
      </p>
    <% } %>

    <div id="map"></div>
  </div>
</main>

<%- include('partials/footer') %>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  const map = L.map('map').setView([25.35, 82.4], 8); // roughly centered between Prayagraj & Varanasi

  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; OpenStreetMap contributors'
  }).addTo(map);

  const events = <%- JSON.stringify(mappedEvents || []) %>;
  const facilities = <%- JSON.stringify(mappedFacilities || []) %>;

  // Distinct color per facility type so they're visually distinguishable at a glance
  const facilityColors = {
    'Ghat': '#1E88E5',
    'Hospital': '#E53935',
    'Police Booth': '#3949AB',
    'Parking': '#6D4C41',
    'Medical Camp': '#00897B'
  };

  function coloredDivIcon(color, emoji) {
    return L.divIcon({
      html: `<div style="background:${color}; width:26px; height:26px; border-radius:50% 50% 50% 0; transform: rotate(-45deg); display:flex; align-items:center; justify-content:center; border:2px solid white; box-shadow:0 2px 6px rgba(0,0,0,0.4);"><span style="transform: rotate(45deg); font-size:13px;">${emoji}</span></div>`,
      className: '',
      iconSize: [26, 26],
      iconAnchor: [13, 26]
    });
  }

  const facilityEmoji = {
    'Ghat': '🕉️',
    'Hospital': '🏥',
    'Police Booth': '👮',
    'Parking': '🅿️',
    'Medical Camp': '⛑️'
  };

  const allMarkers = [];
  const eventLayer = L.layerGroup();
  const facilityLayersByType = {};

  events.forEach(event => {
    const marker = L.marker(event.latlng)
      .bindPopup(`🚩 <strong>${event.title}</strong><br>${event.location}<br>🏷️ ${event.category}<br>🕔 ${event.time} · ${event.date}`);
    marker.addTo(eventLayer);
    allMarkers.push(marker);
  });

  facilities.forEach(f => {
    if (!facilityLayersByType[f.type]) {
      facilityLayersByType[f.type] = L.layerGroup();
    }
    const marker = L.marker(f.latlng, {
      icon: coloredDivIcon(facilityColors[f.type] || '#888', facilityEmoji[f.type] || '📍')
    }).bindPopup(`<strong>${f.name}</strong><br>${f.type}${f.description ? '<br>' + f.description : ''}${f.contact ? '<br>📞 ' + f.contact : ''}`);
    marker.addTo(facilityLayersByType[f.type]);
    allMarkers.push(marker);
  });

  eventLayer.addTo(map);
  Object.values(facilityLayersByType).forEach(layer => layer.addTo(map));

  const overlays = { '🚩 Events': eventLayer };
  Object.keys(facilityLayersByType).forEach(type => {
    overlays[`${facilityEmoji[type] || '📍'} ${type}s`] = facilityLayersByType[type];
  });
  L.control.layers(null, overlays, { collapsed: false }).addTo(map);

  if (allMarkers.length === 0) {
    L.popup()
      .setLatLng([25.35, 82.4])
      .setContent('No mapped locations yet.')
      .openOn(map);
  } else {
    const group = L.featureGroup(allMarkers);
    map.fitBounds(group.getBounds().pad(0.2));
  }
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Schedule</title>
  <%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

<main class="mp-page">
  <section class="container mt-4 mb-5">
    <h2 class="mp-section-title mb-4">🗓️ Full Schedule</h2>

    <form action="/schedule" method="GET" class="mp-filter-bar row g-3 mb-4">
      <div class="col-md-3">
        <label class="form-label">Search</label>
        <input type="text" name="search" class="form-control" placeholder="Event title..." value="<%= query.search || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="All">All</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= query.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Location</label>
        <select name="location" class="form-select">
          <option value="All">All</option>
          <% locations.forEach(loc => { %>
            <option value="<%= loc %>" <%= query.location === loc ? 'selected' : '' %>><%= loc %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="<%= query.from || '' %>">
      </div>
      <div class="col-md-2">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="<%= query.to || '' %>">
      </div>
      <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn mp-btn-primary">Apply Filters</button>
        <a href="/schedule" class="btn mp-btn-outline" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Clear</a>
      </div>
    </form>

    <% if (!events || events.length === 0) { %>
      <div class="mp-empty">
        <p class="fs-5">No events match your filters.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% events.forEach(event => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="card mp-card">
              <div class="card-body">
                <span class="mp-badge mb-2 d-inline-block"><%= event.category %></span>
                <h5 class="card-title"><%= event.title %></h5>
                <% if (event.description) { %>
                  <p class="card-text small text-muted"><%= event.description %></p>
                <% } %>
                <p class="card-text mb-1">📍 <%= event.location %> &middot; 🕔 <%= event.time %></p>
                <p class="card-text text-muted">
                  <%= event.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </p>

                <% if (currentUser) { %>
                  <a href="/edit/<%= event._id %>" class="btn btn-sm mp-btn-warning mt-2 me-2">Edit</a>
                  <form action="/delete/<%= event._id %>" method="POST" class="d-inline"
                        onsubmit="return confirm('Are you sure you want to delete this event?');">
                    <button type="submit" class="btn btn-sm mp-btn-danger mt-2">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</main>

<%- include('partials/footer') %>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Incidents</title>
  <%- include('../partials/head') %>
</head>
<body>

<%- include('../partials/navbar') %>

<main class="mp-page">
  <div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
      <h2 class="mp-section-title">🚨 Incident Reports</h2>
      <% if (currentUser) { %>
        <a href="/incidents/add" class="btn mp-btn-primary btn-sm">+ Report Incident</a>
      <% } %>
    </div>

    <form action="/incidents" method="GET" class="mp-filter-bar row g-3 mb-4">
      <div class="col-md-4">
        <label class="form-label">Category</label>
        <select name="category" class="form-select">
          <option value="All">All</option>
          <% categories.forEach(c => { %>
            <option value="<%= c %>" <%= query.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Severity</label>
        <select name="severity" class="form-select">
          <option value="All">All</option>
          <% severities.forEach(s => { %>
            <option value="<%= s %>" <%= query.severity === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="All">All</option>
          <% statuses.forEach(s => { %>
            <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn mp-btn-primary">Filter</button>
        <a href="/incidents" class="btn mp-btn-outline" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">Clear</a>
      </div>
    </form>

    <% if (!incidents || incidents.length === 0) { %>
      <div class="mp-empty"><p class="fs-5">No incidents match your filters.</p></div>
    <% } else { %>
      <div class="row g-4">
        <% incidents.forEach(inc => { %>
          <div class="col-12 col-sm-6 col-lg-4">
            <div class="card mp-card mp-severity-<%= inc.severity.toLowerCase() %>">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-1 mb-2">
                  <span class="mp-badge"><%= inc.category %></span>
                  <span class="badge mp-sev-badge-<%= inc.severity.toLowerCase() %>"><%= inc.severity %></span>
                </div>
                <h5 class="card-title"><%= inc.title %></h5>
                <p class="card-text small text-muted"><%= inc.description %></p>
                <p class="card-text mb-1">📍 <%= inc.location %></p>
                <p class="card-text small text-muted">
                  <%= inc.createdAt.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                </p>
                <span class="badge bg-secondary mb-2"><%= inc.status %></span>

                <% if (currentUser && (currentUser.role === 'organizer' || currentUser.role === 'admin')) { %>
                  <form action="/incidents/status/<%= inc._id %>" method="POST" class="d-flex gap-2 mt-2">
                    <select name="status" class="form-select form-select-sm">
                      <% statuses.forEach(s => { %>
                        <option value="<%= s %>" <%= inc.status === s ? 'selected' : '' %>><%= s %></option>
                      <% }) %>
                    </select>
                    <button type="submit" class="btn btn-sm mp-btn-warning">Update</button>
                  </form>
                <% } %>

                <% if (currentUser && currentUser.role === 'admin') { %>
                  <form action="/incidents/delete/<%= inc._id %>" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this incident report?');">
                    <button type="submit" class="btn btn-sm mp-btn-danger mt-2">Delete</button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>

</body>
</html>

<% if (typeof siteNotifications !== 'undefined' && siteNotifications.length > 0) { %>
  <div id="mpNotifications" class="mp-notif-wrap"></div>

  <script>
    (function () {
      const notifications = <%- JSON.stringify(siteNotifications) %>;
      const wrap = document.getElementById('mpNotifications');
      const dismissedKey = 'mp-dismissed-banner';

      let dismissedId = null;
      try {
        dismissedId = sessionStorage.getItem(dismissedKey);
      } catch (e) {
        dismissedId = null;
      }

      // Only the single most urgent item is shown as a top banner — the full list
      // lives in the "Active Safety Alerts" section on the homepage instead of
      // stacking many intrusive red bars on every page.
      const top = notifications[0];
      if (!top || top.id === dismissedId) return;

      const extraCount = notifications.length - 1;

      const bar = document.createElement('div');
      bar.className = `mp-notif mp-notif-${top.severity.toLowerCase()}`;
      bar.innerHTML = `
        <a href="${top.link}" class="mp-notif-text">
          ${top.text}${extraCount > 0 ? ` <span class="mp-notif-more">+${extraCount} more active alert${extraCount > 1 ? 's' : ''}</span>` : ''}
        </a>
        <button type="button" class="mp-notif-close" aria-label="Dismiss">&times;</button>
      `;
      bar.querySelector('.mp-notif-close').addEventListener('click', () => {
        try { sessionStorage.setItem(dismissedKey, top.id); } catch (e) {}
        bar.remove();
      });
      wrap.appendChild(bar);
    })();
  </script>
<% } %>

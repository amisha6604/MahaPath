<% if (typeof siteNotifications !== 'undefined' && siteNotifications.length > 0) { %>
  <div id="mpNotifications" class="mp-notif-wrap"></div>

  <script>
    (function () {
      const notifications = <%- safeJson(siteNotifications) %>;
      const wrap = document.getElementById('mpNotifications');
      const dismissedKey = 'mp-dismissed-banner';

      let dismissedId = null;
      try {
        dismissedId = sessionStorage.getItem(dismissedKey);
      } catch (e) {
        dismissedId = null;
      }

      // Only the single most urgent item is shown as a top banner — the full list
      // lives in the "Active Safety Alerts" section on the homepage instead of
      // stacking many intrusive red bars on every page.
      const top = notifications[0];
      if (!top || top.id === dismissedId) return;

      const extraCount = notifications.length - 1;

      // Incident titles/locations come from ANY logged-in user, so they are untrusted.
      // textContent treats everything as plain text — it can never be parsed as HTML.
      const bar = document.createElement('div');
      bar.className = 'mp-notif mp-notif-' + String(top.severity).toLowerCase().replace(/[^a-z]/g, '');

      const link = document.createElement('a');
      link.href = top.link;
      link.className = 'mp-notif-text';
      link.appendChild(document.createTextNode(top.text));

      if (extraCount > 0) {
        const more = document.createElement('span');
        more.className = 'mp-notif-more';
        more.textContent = ' +' + extraCount + ' more active alert' + (extraCount > 1 ? 's' : '');
        link.appendChild(more);
      }

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'mp-notif-close';
      closeBtn.setAttribute('aria-label', 'Dismiss');
      closeBtn.textContent = '\u00d7';
      closeBtn.addEventListener('click', () => {
        try { sessionStorage.setItem(dismissedKey, top.id); } catch (e) {}
        bar.remove();
      });

      bar.appendChild(link);
      bar.appendChild(closeBtn);
      wrap.appendChild(bar);
    })();
  </script>
<% } %>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Home</title>
  <%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

<header class="hero-section text-white d-flex align-items-center justify-content-center">
  <div class="text-center z-2 px-3">
    <h1 class="display-4 fw-bold">🚩 Welcome to Mahapath</h1>
    <p class="lead">Your spiritual path through the Mahakumbh, visualized and scheduled</p>

    <form action="/schedule" method="GET" class="mp-hero-search d-flex">
      <input type="text" name="search" class="form-control" placeholder="Search events, e.g. Shahi Snan...">
      <button type="submit" class="btn">Search</button>
    </form>
  </div>
</header>

<main class="mp-page">
  <section class="mp-about-teaser">
    <div class="container">
      <div class="row align-items-center g-4">
        <div class="col-md-6">
          <div class="mp-about-teaser-image" aria-hidden="true">🕉️</div>
        </div>
        <div class="col-md-6">
          <h2 class="mp-section-title">Know About Mahakumbh</h2>
          <p class="mt-3">
            The Mahakumbh is one of the largest gatherings of faith on Earth — rooted in mythology
            thousands of years old, shaped by rituals passed down through generations, and held only
            once every 144 years at the sacred Sangam in Prayagraj.
          </p>
          <p>Discover the stories, the astrology behind its timing, the Shahi Snan, and the Naga Sadhus who make it so extraordinary.</p>
          <a href="/about-mahakumbh" class="btn mp-btn-primary mt-2">Read the Full Story &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="container mt-5 mb-4">
    <div class="row g-3 text-center">
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/facilities" class="mp-quick-link">
          <div class="mp-quick-icon">🏛️</div>
          <div>Facilities</div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/lost-found" class="mp-quick-link">
          <div class="mp-quick-icon">🔎</div>
          <div>Lost &amp; Found</div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/helplines" class="mp-quick-link">
          <div class="mp-quick-icon">☎️</div>
          <div>Helplines</div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/traffic" class="mp-quick-link">
          <div class="mp-quick-icon">🚧</div>
          <div>Traffic</div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/incidents" class="mp-quick-link">
          <div class="mp-quick-icon">🚨</div>
          <div>Incidents</div>
        </a>
      </div>
      <div class="col-6 col-md-4 col-lg-2">
        <a href="/crowd" class="mp-quick-link">
          <div class="mp-quick-icon">🔥</div>
          <div>Crowd Density</div>
        </a>
      </div>
    </div>
  </section>

  <section class="container mb-5">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
      <h2 class="mp-section-title">📅 Upcoming Events</h2>
      <a href="/schedule" class="mp-btn-outline btn btn-sm" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">View full schedule &rarr;</a>
    </div>

    <div class="row g-4">
      <% if (!events || events.length === 0) { %>
        <div class="mp-empty">
          <p class="fs-5">No upcoming events yet.</p>
          <% if (currentUser) { %>
            <a href="/add" class="btn mp-btn-primary mt-2">Add the first event</a>
          <% } %>
        </div>
      <% } %>

      <% events.forEach(event => { %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card mp-card">
            <div class="card-body">
              <span class="mp-badge mb-2 d-inline-block"><%= event.category %></span>
              <h5 class="card-title"><%= event.title %></h5>
              <p class="card-text mb-1">📍 <%= event.location %> &middot; 🕔 <%= event.time %></p>
              <p class="card-text text-muted">
                <%= event.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
              </p>

              <% if (currentUser) { %>
                <a href="/edit/<%= event._id %>" class="btn btn-sm mp-btn-warning mt-2 me-2">Edit</a>
                <form action="/delete/<%= event._id %>" method="POST" class="d-inline"
                      onsubmit="return confirm('Are you sure you want to delete this event?');">
                  <button type="submit" class="btn btn-sm mp-btn-danger mt-2">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (nearbyPlaces && nearbyPlaces.length > 0) { %>
    <section class="mp-nearby-section py-5">
      <div class="container">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
          <h2 class="mp-section-title">🗺️ Nearby Places Worth Visiting</h2>
          <a href="/nearby" class="mp-btn-outline btn btn-sm" style="color:var(--mp-maroon); border-color:var(--mp-maroon);">See all &rarr;</a>
        </div>
        <p class="text-muted mb-4">Popular pilgrimage stops near Prayagraj — worth adding to your trip before or after the Mahakumbh.</p>
      </div>

      <div class="mp-scroll-row px-3 px-md-5">
        <% nearbyPlaces.forEach(p => { %>
          <a href="/nearby/<%= p._id %>" class="mp-scroll-card">
            <div class="mp-scroll-card-image" style="<%= p.imageUrl ? `background-image:url('${p.imageUrl}');` : '' %>">
              <% if (!p.imageUrl) { %><span>🛕</span><% } %>
            </div>
            <div class="mp-scroll-card-body">
              <span class="mp-badge mb-1 d-inline-block"><%= p.city %></span>
              <h6 class="mb-1"><%= p.name %></h6>
              <p class="small text-muted mb-0"><%= p.shortDescription %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</main>

<%- include('partials/footer') %>

</body>
</html>

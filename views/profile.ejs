<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | My Profile</title>
  <%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

<main class="mp-page">
  <div class="container py-5" style="max-width: 720px;">

    <div class="mp-form-card mb-4">
      <h2 class="mb-3">My Profile</h2>
      <p class="mb-1"><strong>Username:</strong> <%= user.username %></p>
      <p class="mb-1"><strong>Role:</strong> <span class="mp-badge"><%= user.role %></span></p>
      <p class="mb-0"><strong>Joined:</strong>
        <%= user.createdAt.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
      </p>

      <% if (user.role === 'visitor') { %>
        <p class="text-muted small mt-3 mb-0">
          Visitor accounts can browse events, search, and use the map. To add/edit events, ask an admin to upgrade your account to "organizer".
        </p>
      <% } %>
    </div>

    <div class="mp-form-card mb-4">
      <h4 class="mb-3">Change Password</h4>

      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>

      <form action="/profile/password" method="POST">
        <div class="mb-3">
          <label class="form-label">Current Password</label>
          <input type="password" class="form-control" name="currentPassword" required>
        </div>
        <div class="mb-3">
          <label class="form-label">New Password</label>
          <input type="password" class="form-control" name="newPassword" required minlength="6">
        </div>
        <div class="mb-3">
          <label class="form-label">Confirm New Password</label>
          <input type="password" class="form-control" name="confirmNewPassword" required minlength="6">
        </div>
        <button type="submit" class="btn mp-btn-primary">Update Password</button>
      </form>
    </div>

    <% if (user.role === 'organizer' || user.role === 'admin') { %>
      <div class="mp-form-card">
        <h4 class="mb-3">Events You've Added (<%= myEvents.length %>)</h4>
        <% if (myEvents.length === 0) { %>
          <p class="text-muted">You haven't added any events yet. <a href="/add">Add one now</a>.</p>
        <% } else { %>
          <ul class="list-unstyled mb-0">
            <% myEvents.forEach(event => { %>
              <li class="d-flex flex-wrap gap-2 justify-content-between align-items-center py-2 border-bottom">
                <span>
                  <strong><%= event.title %></strong> &middot; <%= event.location %>
                  &middot; <%= event.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
                <a href="/edit/<%= event._id %>" class="btn btn-sm mp-btn-warning">Edit</a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% } %>

  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <title>Mahapath | Forgot Password</title>
  <%- include('partials/head') %>
</head>
<body>

<%- include('partials/navbar') %>

<main class="mp-auth-wrap">
  <div class="mp-form-card mp-auth-card">
    <h2 class="mb-3 text-center">Forgot Password</h2>

    <% if (submitted) { %>
      <div class="alert alert-success">
        If an account with that username exists, an admin has been notified and will reset
        your password. They'll share a temporary password with you directly — once you're
        back in, change it from your profile page.
      </div>
      <p class="text-center mb-0"><a href="/login">&larr; Back to login</a></p>
    <% } else { %>
      <p class="text-muted small mb-3">
        Enter your username and we'll flag your account for an admin to reset. There's no
        email step yet, so an admin will pass you a temporary password directly.
      </p>

      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

      <form action="/forgot-password" method="POST">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input type="text" class="form-control" name="username" required autofocus>
        </div>
        <button type="submit" class="btn mp-btn-primary w-100">Request Password Reset</button>
      </form>

      <p class="text-center mt-3 mb-0 small"><a href="/login">&larr; Back to login</a></p>
    <% } %>
  </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
